# Ability Link Admin Panel (web)
#
# Copy to `.env.local` and fill values from Firebase Console → Project settings → Your apps → Web.
# Add a Web app if you don't have one yet (Flutter currently only has Android/iOS options).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=abilitylink-3ac64.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=abilitylink-3ac64
VITE_FIREBASE_STORAGE_BUCKET=abilitylink-3ac64.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=70258044409
VITE_FIREBASE_APP_ID=

# Same Maps key as the Flutter app. Enable Maps JavaScript API for this key.
VITE_GOOGLE_MAPS_API_KEY=
